---
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:type" content="website" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Андрей Савицкий",
    "jobTitle": "Инвестор, предприниматель",
    "url": "https://savitsky.netlify.app",
    "sameAs": [
      "https://t.me/an_savicky",
      "https://instagram.com/andrey.savitskyy",
      "https://tiktok.com/@an_savicky"
    ]
  })} />
  <style is:global>
    * { margin: 0; box-sizing: border-box; }
    body { background: #0a0a0a; color: #e8eaed; font-family: system-ui, -apple-system, sans-serif; }
    a { color: #d2e0ff; text-decoration: none; }
    
    .navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      background: rgba(10, 10, 10, 0.8);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.1);
      z-index: 100;
    }
    .nav-brand {
      font-size: 1.2rem;
      font-weight: 600;
      color: #fff;
      letter-spacing: 1px;
    }
    .nav-links {
      display: flex;
      gap: 2rem;
    }
    .nav-links a {
      color: rgba(255,255,255,0.7);
      font-size: 0.9rem;
      transition: color 0.2s;
    }
    .nav-links a:hover {
      color: #d2e0ff;
    }
    main {
      padding-top: 64px;
      min-height: 100vh;
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a href="/" class="nav-brand">ANDREY SAVITSKY</a>
    <div class="nav-links">
      <a href="/">Главная</a>
      <a href="/projects/">Проекты</a>
      <a href="/video/">Видео</a>
      <a href="/ai/">AI-Ассистент</a>
      <a href="https://t.me/an_savicky" target="_blank" rel="noopener">Telegram</a>
    </div>
  </nav>

  <main>
    <slot />
  </main>
</body>
</html>
