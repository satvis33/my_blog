---
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:type" content="website" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Андрей Савицкий",
    "jobTitle": "Инвестор, предприниматель",
    "url": "https://savitsky.netlify.app",
    "sameAs": [
      "https://t.me/an_savicky",
      "https://instagram.com/andrey.savitskyy",
      "https://tiktok.com/@an_savicky"
    ]
  })} />
  <style is:global>
    * { margin: 0; box-sizing: border-box; }
    body { background: #0a0a0a; color: #e8eaed; font-family: system-ui, -apple-system, sans-serif; }
    a { color: #d2e0ff; }
  </style>
</head>
<body>
  <slot />
</body>
</html>