---
import Layout from '../layouts/Layout.astro';
const youtubeUrl = "https://www.youtube.com/embed/Azc63zJjTUk";
---

<Layout title="Андрей Савицкий — Инвестор, Предприниматель, Sapphire" description="Инвестиции в акции, солнечную энергию, автобизнес. Herbalife, туризм, Altexera. Личный AI-ассистент.">
  <section class="hero">
    <h1>Андрей Савицкий</h1>
    <p class="subtitle">Инвестор. Предприниматель. Sapphire.</p>
    <p class="desc">Herbalife → Туризм → DeFi. Строю проекты, которые работают.</p>
    <div class="buttons">
      <a href="https://t.me/an_savicky" class="btn-primary" target="_blank" rel="noopener">Telegram</a>
      <a href="/ai/" class="btn-secondary">AI-Ассистент</a>
    </div>
  </section>

  <section class="video">
    <h2>Последнее видео</h2>
    <div class="video-frame">
      <iframe src={youtubeUrl} title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>
  </section>
</Layout>

<style>
  .hero { min-height: 70vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 4rem 2rem; background: radial-gradient(at 89% 46%, rgb(119,127,137) 0%, rgb(32,74,126) 35%, rgb(0,0,0) 75%); }
  .hero h1 { font-size: clamp(2rem, 6vw, 4rem); font-weight: 600; color: #f9fafb; margin: 0; }
  .subtitle { font-size: 1.2rem; color: #d2e0ff; margin: 0.5rem 0; }
  .desc { color: rgba(255,255,255,0.6); max-width: 500px; }
  .buttons { display: flex; gap: 1rem; margin-top: 2rem; }
  .btn-primary { background: #d2e0ff; color: #000; padding: 0.8rem 1.6rem; border-radius: 6px; text-decoration: none; font-weight: 500; }
  .btn-secondary { background: transparent; color: #d2e0ff; padding: 0.8rem 1.6rem; border-radius: 6px; text-decoration: none; border: 1px solid #d2e0ff; }
  .video { padding: 4rem 2rem; text-align: center; }
  .video h2 { color: #f9fafb; margin-bottom: 2rem; }
  .video-frame { max-width: 800px; margin: 0 auto; aspect-ratio: 16/9; }
  .video-frame iframe { width: 100%; height: 100%; border-radius: 12px; }
</style>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
